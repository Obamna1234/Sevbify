<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy: Sevbify's library (playlists, history, settings) is never copied to Google's cloud backup.
     Moving to a new phone with a cable / direct transfer still brings it along. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
    </device-transfer>
</data-extraction-rules>
